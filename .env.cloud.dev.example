# Cloud dev runtime (AWS RDS drill)
# Used by:
#   ./backend/scripts/ops/run_api.sh .env.cloud.dev
#   python backend/scripts/ops/cloud_dev_db_smoke.py --env-file .env.cloud.dev

WORDLOOM_ENV=dev
ENVIRONMENT=cloud-dev
DEBUG=False
LOG_LEVEL=INFO

# Keep cloud-dev API on a separate port from local dev/test.
API_PORT=30021
OUTBOX_METRICS_PORT=9118

# Replace with your current cloud-dev RDS credentials and endpoint.
# For temporary public-access drills, require sslmode=require.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<rds-endpoint>:5432/wlv3_cloud_dev?sslmode=require

# Phase v1 keeps search infra local unless a cloud search/storage path is explicitly introduced.
ELASTIC_URL=http://localhost:19200
ELASTIC_INDEX=wordloom-cloud-dev-search-index

# Optional tracing; keep disabled by default for the first cloud-dev smoke.
WORDLOOM_TRACING_ENABLED=0
OTEL_SDK_DISABLED=1