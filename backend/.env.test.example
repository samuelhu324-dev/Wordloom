# Local test (devtest-db-5435)
# Used by: ./backend/scripts/ops/run_api.sh .env.test
#          ./backend/scripts/ops/run_worker.sh .env.test

WORDLOOM_ENV=test
ENVIRONMENT=devtest-test
DEBUG=False
LOG_LEVEL=WARNING

API_PORT=30011
OUTBOX_METRICS_PORT=9109

# Unified outbox cutover toggles (projection-scoped).
#
# Semantics (for both READ and WRITE):
# - empty / 0 / false: disabled
# - 1 / true / all / *: enabled for all projections
# - otherwise: comma/space/semicolon-separated projection names
#   e.g. "search_index_to_elastic, chronicle_events_to_entries"
#
# OUTBOX_UNIFIED_WRITE_ENABLED=search_index_to_elastic
# OUTBOX_UNIFIED_READ_ENABLED=search_index_to_elastic

# Example connection string; replace <user> and <password> for your environment.
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5435/wordloom_test

# NOTE: Search read is merged-only; legacy stage1 provider envs are no longer used.
# Keep SEARCH_STAGE1_PROVIDER unset.
ELASTIC_URL=http://localhost:19200
ELASTIC_INDEX=wordloom-test-search-index

# Observability (Labs): enable tracing to Jaeger OTLP.
WORDLOOM_TRACING_ENABLED=1
OTEL_TRACES_SAMPLER=always_on
# Default: Jaeger all-in-one OTLP/HTTP
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
