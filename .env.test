# Local test (devtest-db-5435)
# Used by: ./backend/scripts/run_api.sh .env.test
#          ./backend/scripts/run_worker.sh .env.test

WORDLOOM_ENV=test
ENVIRONMENT=devtest-test
DEBUG=False
LOG_LEVEL=WARNING

API_PORT=30011
OUTBOX_METRICS_PORT=9109

DATABASE_URL=postgresql+psycopg://wordloom:wordloom@localhost:5435/wordloom_test

SEARCH_STAGE1_PROVIDER=elastic
ELASTIC_URL=http://localhost:19200
ELASTIC_INDEX=wordloom-test-search-index

# Dual-run worker (Search Outbox → Elasticsearch)
# Default OFF for safety; enable explicitly when you want projection running.
# Used by: Procfile worker_search → backend/scripts/ops/run_worker.sh → backend/scripts/search_outbox_worker.py
SEARCH_OUTBOX_WORKER_ENABLED=0

# Rate/isolations knobs (optional; worker has defaults)
OUTBOX_CONCURRENCY=1
OUTBOX_BULK_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1.0

# Optional scope/isolation: restrict worker claims to these libraries (comma-separated UUIDs).
# Default empty => no restriction.
SEARCH_OUTBOX_LIBRARY_ALLOWLIST=

# Observability (Labs): enable tracing to Jaeger OTLP.
WORDLOOM_TRACING_ENABLED=1
OTEL_TRACES_SAMPLER=always_on
# Default: Jaeger all-in-one OTLP/HTTP
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
